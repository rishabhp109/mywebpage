:root {
  --background: #f7f8fc;
  --text: #1f2937;
  --muted: #64748b;

  --primary: #2563eb;
  --primary-dark: #1e40af;
  --secondary: #7c3aed;
  --accent: #06b6d4;
  --accent-warm: #f97316;

  --card-bg: rgba(255, 255, 255, 0.85);
  --border: rgba(148, 163, 184, 0.25);

  --shadow-sm: 0 4px 12px rgba(15, 23, 42, 0.08);
  --shadow-md: 0 10px 30px rgba(15, 23, 42, 0.12);
  --shadow-lg: 0 20px 50px rgba(15, 23, 42, 0.18);

  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 24px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: Inter, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  line-height: 1.7;
  color: var(--text);
  background:
    radial-gradient(circle at top left, rgba(37, 99, 235, 0.16), transparent 32rem),
    radial-gradient(circle at top right, rgba(124, 58, 237, 0.14), transparent 30rem),
    linear-gradient(180deg, #f8fafc 0%, #eef2ff 45%, #f8fafc 100%);
}

a {
  color: var(--primary);
  text-decoration: none;
  transition: color 0.2s ease, opacity 0.2s ease;
}

a:hover {
  color: var(--secondary);
  text-decoration: none;
}

.container {
  width: min(1120px, 92%);
  margin: 0 auto;
}

/* Header */

.site-header {
  position: relative;
  overflow: hidden;
  color: white;
  padding: 3.2rem 0 3rem;
  background:
    linear-gradient(135deg, rgba(37, 99, 235, 0.95), rgba(124, 58, 237, 0.92)),
    radial-gradient(circle at 20% 20%, rgba(6, 182, 212, 0.45), transparent 25rem);
}

.site-header::before {
  content: "";
  position: absolute;
  inset: -40%;
  background:
    radial-gradient(circle, rgba(255,255,255,0.18) 0 2px, transparent 2px 100%);
  background-size: 38px 38px;
  opacity: 0.25;
  transform: rotate(8deg);
}

.site-header::after {
  content: "";
  position: absolute;
  right: -8rem;
  bottom: -10rem;
  width: 26rem;
  height: 26rem;
  background: rgba(6, 182, 212, 0.25);
  border-radius: 50%;
  filter: blur(5px);
}

.header-content {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  gap: 2rem;
  align-items: center;
  flex-wrap: wrap;
}

.site-header h1 {
  margin: 0;
  font-size: clamp(2.2rem, 5vw, 4rem);
  letter-spacing: -1.5px;
  line-height: 1.1;
}

.subtitle {
  display: inline-block;
  font-size: 1.15rem;
  margin: 0.8rem 0 0.4rem;
  padding: 0.35rem 0.75rem;
  color: #eff6ff;
  background: rgba(255, 255, 255, 0.16);
  border: 1px solid rgba(255, 255, 255, 0.28);
  border-radius: 999px;
  backdrop-filter: blur(8px);
}

.affiliation {
  margin: 0.6rem 0 0;
  color: #e0f2fe;
  font-size: 1rem;
}

/* Navigation */

.nav {
  display: flex;
  gap: 0.7rem;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.nav a {
  color: white;
  font-weight: 700;
  padding: 0.55rem 0.85rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(10px);
  transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
}

.nav a:hover {
  transform: translateY(-2px);
  background: rgba(255, 255, 255, 0.22);
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.2);
}

/* Sections */

.section {
  position: relative;
  margin: 2rem 0;
  padding: 2.4rem;
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  backdrop-filter: blur(14px);
}

.section:first-child {
  margin-top: -2rem;
}

.section h2 {
  display: inline-block;
  color: var(--primary-dark);
  font-size: clamp(1.5rem, 3vw, 2rem);
  margin-top: 0;
  margin-bottom: 1.4rem;
  letter-spacing: -0.5px;
  position: relative;
}

.section h2::after {
  content: "";
  display: block;
  width: 55%;
  height: 4px;
  margin-top: 0.35rem;
  border-radius: 999px;
  background: linear-gradient(90deg, var(--primary), var(--secondary), var(--accent));
}

.section h3 {
  color: var(--primary-dark);
  margin-top: 0;
  margin-bottom: 0.6rem;
}

/* About */

.about-grid {
  display: grid;
  grid-template-columns: 240px 1fr;
  gap: 2.2rem;
  align-items: start;
}

.profile-image-wrapper {
  text-align: center;
  position: relative;
}

.profile-image-wrapper::before {
  content: "";
  position: absolute;
  inset: -12px;
  width: 244px;
  height: 244px;
  margin: auto;
  border-radius: 50%;
  background: conic-gradient(
    from 120deg,
    var(--primary),
    var(--secondary),
    var(--accent),
    var(--accent-warm),
    var(--primary)
  );
  z-index: 0;
  animation: slow-spin 12s linear infinite;
}

.profile-image {
  position: relative;
  z-index: 1;
  width: 220px;
  height: 220px;
  object-fit: cover;
  border-radius: 50%;
  border: 6px solid white;
  box-shadow: var(--shadow-md);
}

@keyframes slow-spin {
  to {
    transform: rotate(360deg);
  }
}

/* Buttons */

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: white;
  padding: 0.78rem 1.1rem;
  margin: 0.6rem 0.45rem 0.6rem 0;
  border-radius: 999px;
  font-weight: 800;
  box-shadow: 0 10px 24px rgba(37, 99, 235, 0.25);
  transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
}

.button:hover {
  color: white;
  transform: translateY(-2px);
  filter: brightness(1.05);
  box-shadow: 0 14px 30px rgba(37, 99, 235, 0.35);
}

.button.secondary {
  background: white;
  color: var(--primary-dark);
  border: 1px solid rgba(37, 99, 235, 0.2);
  box-shadow: var(--shadow-sm);
}

.button.secondary:hover {
  color: var(--secondary);
  background: #f8fafc;
}

/* Cards */

.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.2rem;
}

.card {
  position: relative;
  overflow: hidden;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 1.45rem;
  box-shadow: var(--shadow-sm);
  transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
}

.card::before {
  content: "";
  position: absolute;
  inset: 0 0 auto 0;
  height: 5px;
  background: linear-gradient(90deg, var(--primary), var(--secondary), var(--accent));
}

.card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow-md);
  border-color: rgba(37, 99, 235, 0.28);
}

.card p {
  color: var(--muted);
}

/* Publications */

.publication-list {
  padding-left: 1.3rem;
}

.publication-list li {
  margin-bottom: 1.2rem;
  padding: 1rem 1rem 1rem 1.2rem;
  background: rgba(248, 250, 252, 0.85);
  border-left: 5px solid var(--primary);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
}

.publication-list li:nth-child(2n) {
  border-left-color: var(--secondary);
}

.publication-list li:nth-child(3n) {
  border-left-color: var(--accent);
}

/* Lists */

ul {
  padding-left: 1.2rem;
}

li::marker {
  color: var(--secondary);
}

.link-list {
  list-style: none;
  padding-left: 0;
}

.link-list li {
  display: inline-block;
  margin-right: 0.6rem;
  margin-bottom: 0.7rem;
}

.link-list a {
  display: inline-block;
  padding: 0.5rem 0.8rem;
  border-radius: 999px;
  background: #eef2ff;
  color: var(--primary-dark);
  font-weight: 700;
  border: 1px solid rgba(37, 99, 235, 0.14);
  transition: transform 0.2s ease, background 0.2s ease;
}

.link-list a:hover {
  transform: translateY(-2px);
  background: #e0e7ff;
  color: var(--secondary);
}

/* Footer */

.site-footer {
  margin-top: 2.5rem;
  background: linear-gradient(135deg, #111827, #1e1b4b);
  color: #cbd5e1;
  padding: 2rem 0;
  text-align: center;
  font-size: 0.95rem;
}

.site-footer p {
  margin: 0;
}

/* Responsive */

@media screen and (max-width: 760px) {
  .site-header {
    padding: 2.5rem 0 4rem;
  }

  .header-content {
    align-items: flex-start;
  }

  .nav {
    justify-content: flex-start;
  }

  .section {
    padding: 1.5rem;
    border-radius: 18px;
  }

  .section:first-child {
    margin-top: -2.8rem;
  }

  .about-grid {
    grid-template-columns: 1fr;
  }

  .profile-image-wrapper {
    text-align: left;
    width: 220px;
  }

  .profile-image-wrapper::before {
    left: -12px;
    right: auto;
  }

  .profile-image {
    width: 200px;
    height: 200px;
  }
}

@media screen and (max-width: 480px) {
  .nav a {
    font-size: 0.9rem;
    padding: 0.48rem 0.7rem;
  }

  .section {
    padding: 1.25rem;
  }

  .button {
    width: 100%;
    margin-right: 0;
  }

  .link-list li {
    display: block;
  }

  .link-list a {
    width: 100%;
  }
}
