:root {
  --bg: #f6f8fc;
  --bg-soft: #eef4ff;
  --text: #182230;
  --text-soft: #475569;
  --muted: #64748b;

  --primary: #2563eb;
  --primary-dark: #1d4ed8;
  --secondary: #7c3aed;
  --accent: #06b6d4;
  --green: #10b981;
  --orange: #f97316;

  --white: #ffffff;
  --card: rgba(255, 255, 255, 0.82);
  --border: rgba(148, 163, 184, 0.25);

  --shadow-sm: 0 8px 24px rgba(15, 23, 42, 0.08);
  --shadow-md: 0 18px 45px rgba(15, 23, 42, 0.12);
  --shadow-lg: 0 30px 70px rgba(15, 23, 42, 0.18);

  --radius-sm: 10px;
  --radius-md: 18px;
  --radius-lg: 28px;
  --radius-full: 999px;
}

/* Base */

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Roboto,
    Arial,
    sans-serif;
  line-height: 1.7;
  color: var(--text);
  background:
    radial-gradient(circle at top left, rgba(37, 99, 235, 0.16), transparent 34rem),
    radial-gradient(circle at top right, rgba(124, 58, 237, 0.14), transparent 32rem),
    radial-gradient(circle at 50% 15%, rgba(6, 182, 212, 0.10), transparent 30rem),
    linear-gradient(180deg, #f8fafc 0%, #eef4ff 45%, #ffffff 100%);
  min-height: 100vh;
}

img {
  max-width: 100%;
}

a {
  color: var(--primary);
  text-decoration: none;
  transition:
    color 0.2s ease,
    background 0.2s ease,
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

a:hover {
  color: var(--secondary);
}

.container {
  width: min(1120px, 92%);
  margin: 0 auto;
}

/* Header */

.site-header {
  position: relative;
  overflow: hidden;
  color: var(--white);
  padding: 4rem 0 5.5rem;
  background:
    linear-gradient(135deg, rgba(37, 99, 235, 0.96), rgba(124, 58, 237, 0.92)),
    radial-gradient(circle at 20% 20%, rgba(6, 182, 212, 0.55), transparent 26rem);
}

.site-header::before {
  content: "";
  position: absolute;
  inset: -50%;
  background-image:
    linear-gradient(rgba(255,255,255,0.11) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.11) 1px, transparent 1px);
  background-size: 44px 44px;
  transform: rotate(8deg);
  opacity: 0.22;
}

.site-header::after {
  content: "";
  position: absolute;
  right: -9rem;
  bottom: -12rem;
  width: 30rem;
  height: 30rem;
  border-radius: 50%;
  background:
    radial-gradient(circle, rgba(6, 182, 212, 0.38), rgba(6, 182, 212, 0.04));
  filter: blur(2px);
}

.header-content {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 2rem;
  flex-wrap: wrap;
}

.site-header h1 {
  margin: 0;
  font-size: clamp(2.5rem, 6vw, 4.6rem);
  line-height: 1;
  letter-spacing: -2px;
}

.subtitle {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  margin: 1rem 0 0.5rem;
  padding: 0.45rem 0.85rem;
  width: fit-content;
  color: #eff6ff;
  font-size: 1.05rem;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.16);
  border: 1px solid rgba(255, 255, 255, 0.24);
  border-radius: var(--radius-full);
  backdrop-filter: blur(12px);
}

.subtitle::before {
  content: "";
  width: 0.55rem;
  height: 0.55rem;
  background: #22c55e;
  border-radius: 50%;
  box-shadow: 0 0 0 6px rgba(34, 197, 94, 0.18);
}

.affiliation {
  margin: 0.7rem 0 0;
  color: #dbeafe;
  font-size: 1.02rem;
}

/* Navigation */

.nav {
  display: flex;
  gap: 0.7rem;
  justify-content: flex-end;
  flex-wrap: wrap;
}

.nav a {
  color: var(--white);
  font-weight: 800;
  font-size: 0.95rem;
  padding: 0.62rem 0.9rem;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.13);
  border: 1px solid rgba(255, 255, 255, 0.20);
  backdrop-filter: blur(14px);
}

.nav a:hover {
  color: var(--white);
  transform: translateY(-2px);
  background: rgba(255, 255, 255, 0.23);
  box-shadow: 0 12px 28px rgba(15, 23, 42, 0.22);
}

/* Main sections */

main.container {
  position: relative;
  margin-top: -3.4rem;
}

.section {
  position: relative;
  margin: 0 0 1.6rem;
  padding: 2.4rem;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  backdrop-filter: blur(18px);
  overflow: hidden;
}

.section::before {
  content: "";
  position: absolute;
  inset: 0 0 auto 0;
  height: 5px;
  background: linear-gradient(
    90deg,
    var(--primary),
    var(--secondary),
    var(--accent),
    var(--green)
  );
}

.section:hover {
  box-shadow: var(--shadow-md);
}

.section h2 {
  position: relative;
  display: inline-block;
  margin: 0 0 1.4rem;
  color: #111827;
  font-size: clamp(1.45rem, 3vw, 2rem);
  line-height: 1.2;
  letter-spacing: -0.8px;
}

.section h2::after {
  content: "";
  display: block;
  width: 58%;
  height: 4px;
  margin-top: 0.45rem;
  border-radius: var(--radius-full);
  background: linear-gradient(90deg, var(--primary), var(--secondary), var(--accent));
}

.section h3 {
  margin-top: 0;
  margin-bottom: 0.6rem;
  color: #1e3a8a;
  letter-spacing: -0.3px;
}

.section p {
  color: var(--text-soft);
}

/* About */

.about-grid {
  display: grid;
  grid-template-columns: 250px 1fr;
  gap: 2.3rem;
  align-items: start;
}

.profile-image-wrapper {
  position: relative;
  text-align: center;
  width: 250px;
}

.profile-image-wrapper::before {
  content: "";
  position: absolute;
  inset: -12px;
  width: 250px;
  height: 250px;
  margin: auto;
  border-radius: 50%;
  background: conic-gradient(
    from 130deg,
    var(--primary),
    var(--secondary),
    var(--accent),
    var(--orange),
    var(--primary)
  );
  z-index: 0;
  animation: rotate-ring 12s linear infinite;
}

.profile-image-wrapper::after {
  content: "";
  position: absolute;
  right: 18px;
  bottom: 18px;
  width: 18px;
  height: 18px;
  background: var(--green);
  border: 4px solid white;
  border-radius: 50%;
  z-index: 2;
  box-shadow: var(--shadow-sm);
}

.profile-image {
  position: relative;
  z-index: 1;
  width: 226px;
  height: 226px;
  object-fit: cover;
  border-radius: 50%;
  border: 7px solid var(--white);
  box-shadow: var(--shadow-md);
}

@keyframes rotate-ring {
  to {
    transform: rotate(360deg);
  }
}

/* Buttons */

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.45rem;
  margin: 0.6rem 0.45rem 0.6rem 0;
  padding: 0.82rem 1.15rem;
  color: var(--white);
  font-weight: 900;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  box-shadow: 0 12px 28px rgba(37, 99, 235, 0.28);
}

.button:hover {
  color: var(--white);
  transform: translateY(-3px);
  box-shadow: 0 18px 38px rgba(37, 99, 235, 0.38);
}

.button.secondary {
  color: #1e3a8a;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(37, 99, 235, 0.20);
  box-shadow: var(--shadow-sm);
}

.button.secondary:hover {
  color: var(--secondary);
  background: var(--white);
}

/* Cards */

.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(255px, 1fr));
  gap: 1.2rem;
}

.card {
  position: relative;
  overflow: hidden;
  padding: 1.45rem;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.92), rgba(255,255,255,0.76));
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  transition:
    transform 0.22s ease,
    box-shadow 0.22s ease,
    border-color 0.22s ease;
}

.card::before {
  content: "";
  position: absolute;
  inset: 0 0 auto 0;
  height: 5px;
  background: linear-gradient(90deg, var(--primary), var(--secondary), var(--accent));
}

.card::after {
  content: "";
  position: absolute;
  right: -3.5rem;
  bottom: -3.5rem;
  width: 8rem;
  height: 8rem;
  background: rgba(37, 99, 235, 0.08);
  border-radius: 50%;
}

.card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-md);
  border-color: rgba(37, 99, 235, 0.30);
}

.card p {
  color: var(--muted);
}

/* Publications */

.publication-list {
  padding-left: 1.2rem;
}

.publication-list li {
  margin-bottom: 1rem;
  padding: 1rem 1.1rem 1rem 1.2rem;
  color: var(--text-soft);
  background: rgba(248, 250, 252, 0.90);
  border-left: 5px solid var(--primary);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
}

.publication-list li:nth-child(2n) {
  border-left-color: var(--secondary);
}

.publication-list li:nth-child(3n) {
  border-left-color: var(--accent);
}

.publication-list strong {
  color: #0f172a;
}

/* Lists */

ul {
  padding-left: 1.2rem;
}

li {
  color: var(--text-soft);
}

li::marker {
  color: var(--secondary);
}

.link-list {
  list-style: none;
  padding-left: 0;
}

.link-list li {
  display: inline-block;
  margin: 0 0.55rem 0.7rem 0;
}

.link-list a {
  display: inline-flex;
  align-items: center;
  padding: 0.55rem 0.85rem;
  color: #1e3a8a;
  font-weight: 800;
  border-radius: var(--radius-full);
  background: #eef2ff;
  border: 1px solid rgba(37, 99, 235, 0.16);
}

.link-list a:hover {
  color: var(--secondary);
  transform: translateY(-2px);
  background: #e0e7ff;
  box-shadow: var(--shadow-sm);
}

/* Footer */

.site-footer {
  margin-top: 2.8rem;
  padding: 2.1rem 0;
  text-align: center;
  color: #cbd5e1;
  background:
    radial-gradient(circle at top left, rgba(37, 99, 235, 0.28), transparent 20rem),
    linear-gradient(135deg, #0f172a, #1e1b4b);
}

.site-footer p {
  margin: 0;
}

/* Small animation */

.section,
.card,
.button,
.nav a,
.link-list a {
  transition:
    transform 0.22s ease,
    box-shadow 0.22s ease,
    background 0.22s ease,
    color 0.22s ease,
    border-color 0.22s ease;
}

/* Responsive */

@media screen and (max-width: 780px) {
  .site-header {
    padding: 3rem 0 5rem;
  }

  .header-content {
    align-items: flex-start;
  }

  .nav {
    justify-content: flex-start;
  }

  main.container {
    margin-top: -3rem;
  }

  .section {
    padding: 1.55rem;
    border-radius: 22px;
  }

  .about-grid {
    grid-template-columns: 1fr;
  }

  .profile-image-wrapper {
    width: 226px;
    text-align: left;
  }

  .profile-image-wrapper::before {
    left: -12px;
    right: auto;
    width: 226px;
    height: 226px;
  }

  .profile-image {
    width: 202px;
    height: 202px;
  }

  .profile-image-wrapper::after {
    right: 18px;
    bottom: 16px;
  }
}

@media screen and (max-width: 500px) {
  .site-header h1 {
    letter-spacing: -1px;
  }

  .nav a {
    font-size: 0.88rem;
    padding: 0.5rem 0.72rem;
  }

  .section {
    padding: 1.25rem;
  }

  .button {
    width: 100%;
    margin-right: 0;
  }

  .link-list li {
    display: block;
    margin-right: 0;
  }

  .link-list a {
    width: 100%;
    justify-content: center;
  }
}
