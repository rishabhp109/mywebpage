/* =========================================================
   VERY COLOURFUL MODERN ACADEMIC WEBSITE
   Replace your full style.css with this file
   ========================================================= */

:root { 
  --pink: #ff3cac;
  --purple: #784ba0;
  --blue: #2b86c5;
  --cyan: #00d4ff;
  --green: #00f5a0;
  --yellow: #ffe53b;
  --orange: #ff8a00;
  --red: #ff3d77;

  --dark: #111827;
  --text: #1f2937;
  --soft-text: #475569;
  --white: #ffffff;

  --glass: rgba(255, 255, 255, 0.78);
  --glass-strong: rgba(255, 255, 255, 0.92);
  --border: rgba(255, 255, 255, 0.45);

  --shadow: 0 20px 50px rgba(15, 23, 42, 0.16);
  --shadow-soft: 0 10px 28px rgba(15, 23, 42, 0.10);

  --radius: 26px;
  --radius-small: 14px;
  --radius-pill: 999px;
}

/* Reset */

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family:
    Inter,
    "Segoe UI",
    Roboto,
    Helvetica,
    Arial,
    sans-serif;
  color: var(--text);
  line-height: 1.75;
  min-height: 100vh;

  background:
    radial-gradient(circle at 10% 10%, rgba(255, 60, 172, 0.30), transparent 28rem),
    radial-gradient(circle at 90% 8%, rgba(0, 212, 255, 0.32), transparent 30rem),
    radial-gradient(circle at 50% 45%, rgba(255, 229, 59, 0.28), transparent 34rem),
    radial-gradient(circle at 15% 90%, rgba(0, 245, 160, 0.28), transparent 30rem),
    linear-gradient(135deg, #fff7ed 0%, #fdf2f8 25%, #eef2ff 55%, #ecfeff 100%);
  background-attachment: fixed;
  overflow-x: hidden;
}

/* Colourful animated background shapes */

body::before,
body::after {
  content: "";
  position: fixed;
  z-index: -1;
  border-radius: 50%;
  filter: blur(12px);
  opacity: 0.55;
  pointer-events: none;
}

body::before {
  width: 340px;
  height: 340px;
  left: -120px;
  top: 240px;
  background: linear-gradient(135deg, var(--pink), var(--orange));
  animation: floatBlobOne 14s ease-in-out infinite alternate;
}

body::after {
  width: 380px;
  height: 380px;
  right: -130px;
  bottom: 120px;
  background: linear-gradient(135deg, var(--cyan), var(--green));
  animation: floatBlobTwo 16s ease-in-out infinite alternate;
}

@keyframes floatBlobOne {
  from {
    transform: translate(0, 0) scale(1);
  }
  to {
    transform: translate(80px, -60px) scale(1.15);
  }
}

@keyframes floatBlobTwo {
  from {
    transform: translate(0, 0) scale(1);
  }
  to {
    transform: translate(-80px, 70px) scale(1.12);
  }
}

/* Basic elements */

a {
  color: var(--blue);
  text-decoration: none;
  font-weight: 700;
  transition: all 0.25s ease;
}

a:hover {
  color: var(--pink);
}

img {
  max-width: 100%;
}

.container {
  width: min(1120px, 92%);
  margin: 0 auto;
}

/* Header */

.site-header {
  position: relative;
  overflow: hidden;
  color: white;
  padding: 4.5rem 0 6rem;
  background:
    linear-gradient(
      120deg,
      rgba(255, 60, 172, 0.96),
      rgba(120, 75, 160, 0.96),
      rgba(43, 134, 197, 0.96),
      rgba(0, 212, 255, 0.92)
    );
  background-size: 300% 300%;
  animation: headerGradient 10s ease infinite;
}

@keyframes headerGradient {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}

/* Header decorative layer */

.site-header::before {
  content: "";
  position: absolute;
  inset: -50%;
  background-image:
    radial-gradient(circle, rgba(255,255,255,0.35) 2px, transparent 2px),
    linear-gradient(rgba(255,255,255,0.12) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.12) 1px, transparent 1px);
  background-size: 38px 38px, 70px 70px, 70px 70px;
  transform: rotate(8deg);
  opacity: 0.25;
}

.site-header::after {
  content: "";
  position: absolute;
  right: -9rem;
  bottom: -12rem;
  width: 32rem;
  height: 32rem;
  border-radius: 50%;
  background:
    radial-gradient(circle, rgba(255, 229, 59, 0.65), rgba(255, 255, 255, 0.05));
  filter: blur(3px);
}

.header-content {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 2rem;
  flex-wrap: wrap;
}

.site-header h1 {
  margin: 0;
  font-size: clamp(2.6rem, 7vw, 5rem);
  line-height: 0.95;
  letter-spacing: -2.5px;
  text-shadow: 0 8px 28px rgba(0, 0, 0, 0.22);
}

.subtitle {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  width: fit-content;
  margin: 1.1rem 0 0.6rem;
  padding: 0.55rem 1rem;
  color: white;
  font-size: 1.08rem;
  font-weight: 900;
  background: rgba(255, 255, 255, 0.18);
  border: 1px solid rgba(255, 255, 255, 0.34);
  border-radius: var(--radius-pill);
  backdrop-filter: blur(14px);
  box-shadow: 0 10px 28px rgba(15, 23, 42, 0.18);
}

.subtitle::before {
  content: "";
  width: 0.65rem;
  height: 0.65rem;
  border-radius: 50%;
  background: var(--green);
  box-shadow:
    0 0 0 6px rgba(0, 245, 160, 0.22),
    0 0 20px rgba(0, 245, 160, 0.9);
}

.affiliation {
  margin: 0.7rem 0 0;
  color: #f8fafc;
  font-size: 1.04rem;
  font-weight: 500;
}

/* Navigation */

.nav {
  display: flex;
  gap: 0.75rem;
  justify-content: flex-end;
  flex-wrap: wrap;
}

.nav a {
  color: white;
  font-weight: 900;
  font-size: 0.95rem;
  padding: 0.68rem 0.98rem;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.16);
  border: 1px solid rgba(255, 255, 255, 0.28);
  backdrop-filter: blur(14px);
  box-shadow: 0 8px 22px rgba(15, 23, 42, 0.15);
}

.nav a:hover {
  color: white;
  transform: translateY(-3px) scale(1.03);
  background: rgba(255, 255, 255, 0.28);
  box-shadow: 0 16px 34px rgba(15, 23, 42, 0.25);
}

/* Main */

main.container {
  position: relative;
  margin-top: -3.8rem;
}

/* Sections */

.section {
  position: relative;
  margin: 0 0 1.8rem;
  padding: 2.6rem;
  background: var(--glass);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow-soft);
  backdrop-filter: blur(20px);
  overflow: hidden;
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease;
}

.section:hover {
  transform: translateY(-4px);
  background: var(--glass-strong);
  box-shadow: var(--shadow);
}

/* Colour top line on each section */

.section::before {
  content: "";
  position: absolute;
  inset: 0 0 auto 0;
  height: 7px;
  background: linear-gradient(
    90deg,
    var(--pink),
    var(--orange),
    var(--yellow),
    var(--green),
    var(--cyan),
    var(--blue),
    var(--purple)
  );
}

/* Small colourful corner bubble */

.section::after {
  content: "";
  position: absolute;
  right: -50px;
  top: -50px;
  width: 140px;
  height: 140px;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255, 60, 172, 0.18), rgba(0, 212, 255, 0.18));
}

.section h2 {
  position: relative;
  display: inline-block;
  margin: 0 0 1.4rem;
  color: var(--dark);
  font-size: clamp(1.55rem, 3.2vw, 2.15rem);
  line-height: 1.15;
  letter-spacing: -0.9px;
}

.section h2::after {
  content: "";
  display: block;
  width: 70%;
  height: 5px;
  margin-top: 0.48rem;
  border-radius: var(--radius-pill);
  background: linear-gradient(90deg, var(--pink), var(--orange), var(--cyan));
}

.section h3 {
  margin-top: 0;
  margin-bottom: 0.65rem;
  color: var(--purple);
  font-size: 1.2rem;
}

.section p {
  color: var(--soft-text);
}

/* About section */

.about-grid {
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: 2.4rem;
  align-items: start;
}

.profile-image-wrapper {
  position: relative;
  width: 260px;
  text-align: center;
}

/* Rainbow rotating photo ring */

.profile-image-wrapper::before {
  content: "";
  position: absolute;
  inset: -14px;
  width: 260px;
  height: 260px;
  margin: auto;
  border-radius: 50%;
  background: conic-gradient(
    from 90deg,
    var(--pink),
    var(--orange),
    var(--yellow),
    var(--green),
    var(--cyan),
    var(--blue),
    var(--purple),
    var(--pink)
  );
  z-index: 0;
  animation: rainbowSpin 9s linear infinite;
  box-shadow: 0 18px 40px rgba(120, 75, 160, 0.24);
}

/* Online/status dot */

.profile-image-wrapper::after {
  content: "";
  position: absolute;
  right: 20px;
  bottom: 20px;
  width: 20px;
  height: 20px;
  background: var(--green);
  border: 5px solid white;
  border-radius: 50%;
  z-index: 2;
  box-shadow:
    0 0 0 7px rgba(0, 245, 160, 0.18),
    0 0 20px rgba(0, 245, 160, 0.85);
}

.profile-image {
  position: relative;
  z-index: 1;
  width: 232px;
  height: 232px;
  object-fit: cover;
  border-radius: 50%;
  border: 8px solid white;
  box-shadow: var(--shadow);
}

@keyframes rainbowSpin {
  to {
    transform: rotate(360deg);
  }
}

/* Buttons */

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.45rem;
  margin: 0.7rem 0.5rem 0.7rem 0;
  padding: 0.88rem 1.2rem;
  color: white;
  font-weight: 950;
  letter-spacing: 0.2px;
  border-radius: var(--radius-pill);
  background:
    linear-gradient(135deg, var(--pink), var(--purple), var(--blue));
  background-size: 200% 200%;
  box-shadow: 0 14px 30px:root {
  --bg: #f6f8fc;
  --bg-soft: #eef4ff;
  --text: #182230;
  --text-soft: #475569;
  --muted: #64748b;

  --primary: #2563eb;
  --primary-dark: #1d4ed8;
  --secondary: #7c3aed;
  --accent: #06b6d4;
  --green: #10b981;
  --orange: #f97316;

  --white: #ffffff;
  --card: rgba(255, 255, 255, 0.82);
  --border: rgba(148, 163, 184, 0.25);

  --shadow-sm: 0 8px 24px rgba(15, 23, 42, 0.08);
  --shadow-md: 0 18px 45px rgba(15, 23, 42, 0.12);
  --shadow-lg: 0 30px 70px rgba(15, 23, 42, 0.18);

  --radius-sm: 10px;
  --radius-md: 18px;
  --radius-lg: 28px;
  --radius-full: 999px;
}

/* Base */

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
 rgba(255, 60, 172, 0.28);
  animation: buttonGradient 5s ease infinite;
}

@keyframes buttonGradient {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}

.button:hover {
  color: white;
  transform: translateY(-3px) scale(1.03);
  box-shadow: 0 20px 42px rgba(120, 75, 160, 0.35);
}

.button.secondary {
  color: var(--purple);
  background: white;
  border: 2px solid rgba(120, 75, 160, 0.20);
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.10);
  animation: none;
}

.button.secondary:hover {
  color: var(--pink);
  background: #fff7fb;
}

/* Cards */

.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(255px, 1fr));
  gap: 1.25rem;
}

.card {
  position: relative;
  overflow: hidden;
  padding: 1.55rem;
  background: rgba(255, 255, 255, 0.86);
  border: 1px solid rgba(255, 255, 255, 0.60);
  border-radius: 22px;
  box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    border-color 0.25s ease;
}

.card::before {
  content: "";
  position: absolute;
  inset: 0 0 auto 0;
  height: 7px;
  background: linear-gradient(90deg, var(--pink), var(--orange), var(--cyan));
}

.card::after {
  content: "";
  position: absolute;
  right: -55px;
  bottom: -55px;
  width: 130px;
  height: 130px;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255, 229, 59, 0.20), rgba(0, 212, 255, 0.18));
}

.card:nth-child(2n)::before {
  background: linear-gradient(90deg, var(--green), var(--cyan), var(--blue));
}

.card:nth-child(3n)::before {
  background: linear-gradient(90deg, var(--purple), var(--pink), var(--orange));
}

.card:hover {
  transform: translateY(-7px) rotate(-0.5deg);
  box-shadow: 0 22px 46px rgba(15, 23, 42, 0.15);
  border-color: rgba(255, 60, 172, 0.35);
}

.card h3 {
  position: relative;
  z-index: 1;
}

.card p,
.card a {
  position: relative;
  z-index: 1;
}

.card p {
  color: var(--soft-text);
}

/* Publications */

.publication-list {
  padding-left: 1.2rem;
}

.publication-list li {
  margin-bottom: 1rem;
  padding: 1.05rem 1.15rem 1.05rem 1.25rem;
  color: var(--soft-text);
  background: rgba(255, 255, 255, 0.82);
  border-left: 7px solid var(--pink);
  border-radius: 0 16px 16px 0;
  box-shadow: 0 8px 22px rgba(15, 23, 42, 0.07);
}

.publication-list li:nth-child(2n) {
  border-left-color: var(--cyan);
}

.publication-list li:nth-child(3n) {
  border-left-color: var(--orange);
}

.publication-list li:nth-child(4n) {
  border-left-color: var(--green);
}

.publication-list strong {
  color: var(--dark);
}

/* General lists */

ul {
  padding-left: 1.25rem;
}

li {
  color: var(--soft-text);
}

li::marker {
  color: var(--pink);
}

/* Contact/profile links */

.link-list {
  list-style: none;
  padding-left: 0;
}

.link-list li {
  display: inline-block;
  margin: 0 0.6rem 0.75rem 0;
}

.link-list a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.62rem 0.95rem;
  color: var(--purple);
  font-weight: 900;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.88);
  border: 2px solid rgba(255, 60, 172, 0.16);
  box-shadow: 0 8px 20px rgba(15, 23, 42, 0.07);
}

.link-list a:hover {
  color: white;
  transform: translateY(-3px);
  background: linear-gradient(135deg, var(--pink), var(--purple), var(--blue));
  box-shadow: 0 14px 30px rgba(120, 75, 160, 0.25);
}

/* Footer */

.site-footer {
  position: relative;
  overflow: hidden;
  margin-top: 3rem;
  padding: 2.4rem 0;
  text-align: center;
  color: white;
  background:
    linear-gradient(120deg, #111827, #312e81, #7c2d12);
}

.site-footer::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 20% 20%, rgba(255, 60, 172, 0.35), transparent 20rem),
    radial-gradient(circle at 80% 20%, rgba(0, 212, 255, 0.30), transparent 20rem);
}

.site-footer .container {
  position: relative;
  z-index: 1;
}

.site-footer p {
  margin: 0;
  color: #f8fafc;
}

/* Better focus for accessibility */

a:focus-visible,
.button:focus-visible,
.nav a:focus-visible {
  outline: 4px solid rgba(255, 229, 59, 0.85);
  outline-offset: 4px;
}

/* Responsive design */

@media screen and (max-width: 820px) {
  .site-header {
    padding: 3.4rem 0 5.5rem;
  }

  .header-content {
    align-items: flex-start;
  }

  .nav {
    justify-content: flex-start;
  }

  main.container {
    margin-top: -3.5rem;
  }

  .section {
    padding: 1.7rem;
    border-radius: 22px;
  }

  .about-grid {
    grid-template-columns: 1fr;
  }

  .profile-image-wrapper {
    width: 232px;
    text-align: left;
  }

  .profile-image-wrapper::before {
    left: -14px;
    right: auto;
    width: 232px;
    height: 232px;
  }

  .profile-image {
    width: 204px;
    height: 204px;
  }

  .profile-image-wrapper::after {
    right: 18px;
    bottom: 16px;
  }
}

@media screen and (max-width: 520px) {
  .site-header h1 {
    letter-spacing: -1.2px;
  }

  .subtitle {
    font-size: 0.95rem;
  }

  .nav a {
    font-size: 0.86rem;
    padding: 0.52rem 0.72rem;
  }

  .section {
    padding: 1.3rem;
  }

  .button {
    width: 100%;
    margin-right: 0;
  }

  .link-list li {
    display: block;
    margin-right: 0;
  }

  .link-list a {
    width: 100%;
  }
}


@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation: none !important;
    transition: none !important;
    scroll-behavior: auto !important;
  }
}
